# Copy this file to .env.local for local development.
# On Webflow Cloud, add these in your environment's "Environment variables" tab.

# Supabase project (Project Settings → API). Both values are safe to be public.
NEXT_PUBLIC_SUPABASE_URL=https://dnxbkomhsjvbtuwgximv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_u4vLe6KlphKh_Vu7VSvM5g_pX0VHqcB

# The full public address of the app, including the mount path.
# Used in sign-up confirmation emails. Example: https://sac.webflow.io/app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Webflow Cloud mount path (leave empty for local development).
NEXT_PUBLIC_BASE_PATH=

# Optional: email notifications for inquiries and new feedback.
# Add these as SECRETS in Webflow Cloud, never in this file.
# SUPABASE_SECRET_KEY=sb_secret_...
# RESEND_API_KEY=re_...
# EMAIL_FROM="SAC <hello@yourdomain.com>"
